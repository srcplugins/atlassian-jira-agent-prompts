{
  "name": "@srcplugins/atlassian-jira-agent-prompts",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Prompts for Jira: reusable coding-agent prompts as Jira issues, copied into work issues.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:ui": "node build-ui.mjs",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,html,css,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,html,css,yml,yaml}\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "licenses:check": "node config/check-licenses.mjs .",
    "notices": "node config/check-licenses.mjs . --write-notices",
    "check": "npm run format:check && npm run lint && npm run knip && npm run typecheck && npm run build:ui --if-present && npm test && npm run plugin:check && npm run licenses:check",
    "plugin:check": "node config/check-plugin.mjs",
    "knip": "knip --no-progress"
  },
  "dependencies": {
    "@atlaskit/button": "25.4.2",
    "@atlaskit/select": "23.1.0",
    "@atlaskit/spinner": "20.4.4",
    "@forge/api": "8.1.0",
    "@forge/bridge": "7.0.0",
    "@forge/jira-bridge": "1.2.0",
    "@forge/kvs": "2.0.6",
    "@forge/react": "12.2.0",
    "@forge/resolver": "2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@forge/cli": "file:.local/toolchain/forge-cli-14.0.0.tgz",
    "@playwright/test": "1.63.0",
    "@srcplugins/atlassian-forge-test-framework": "github:srcplugins/atlassian-forge-test-framework#v0.2.1",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "knip": "6.41.0",
    "prettier": "3.9.9",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "prosemirror-view": "1.42.3",
    "@forge/cli": {
      "@babel/core": "7.29.6",
      "adm-zip": "0.6.1",
      "ajv@^6": "6.14.0",
      "body-parser@^1": "1.20.6",
      "brace-expansion@^1": "1.1.21",
      "brace-expansion@^5": "5.0.12",
      "browserslist": "4.28.7",
      "diff": "8.0.3",
      "fast-uri": "3.1.8",
      "follow-redirects": "1.16.0",
      "form-data": "4.0.6",
      "http-proxy-middleware@^2": "2.0.10",
      "launch-editor": "2.14.1",
      "lodash": "4.18.1",
      "minimatch@^3": "3.1.4",
      "path-to-regexp@^0.1": "0.1.13",
      "picomatch@^2": "2.3.2",
      "qs": "6.16.0",
      "shell-quote": "1.12.0",
      "tar-fs@^2": "2.1.4",
      "tmp": "0.2.7",
      "webpack-dev-server": "5.2.6",
      "websocket-driver": "0.7.5",
      "ws@^7": "7.5.11",
      "ws@^8": "8.21.0",
      "yaml": "2.8.3"
    },
    "sockjs": {
      "uuid": "11.1.1"
    },
    "brace-expansion@^5": "5.0.12"
  }
}
